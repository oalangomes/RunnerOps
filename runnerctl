#!/usr/bin/env bash
set -euo pipefail

RUNNERCTL_VERSION="0.4.0"

if [[ "${1:-}" == "--version" ]]; then
  printf 'runnerctl %s\n' "$RUNNERCTL_VERSION"
  exit 0
fi

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/actions-runners"
PLATFORM_HOME_FILE="$CONFIG_HOME/platform-home"

die() {
  echo "ERRO: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
runnerctl — local GitHub Actions runner control plane

Uso:
  runnerctl --version
  runnerctl help [command]

Bootstrap:
  runnerctl init

Inventory and diagnostics:
  runnerctl list
  runnerctl groups
  runnerctl status [runner|group:<group>|all]
  runnerctl health [runner|group:<group>|all]
  runnerctl doctor [runner|group:<group>|all]
  runnerctl logs <runner|group:<group>|all> [--lines N] [--since DURATION] [--follow]

Lifecycle:
  runnerctl start <runner|group:<group>|all>
  runnerctl stop <runner|group:<group>|all>
  runnerctl restart <runner|group:<group>|all>
  runnerctl plan [runner|group:<group>|all]
  runnerctl migrate <runner|group:<group>|all>
  runnerctl on-demand <runner|group:<group>|all>
  runnerctl autostart <runner|group:<group>|all>

Repository operations:
  runnerctl repo [owner/repo|.]
  runnerctl overview [owner/repo|.]
  runnerctl ensure [owner/repo|.]
  runnerctl add [owner/repo|.] [--profile PROFILE] [--group GROUP] [--labels CSV] [--name NAME]
                 [--runner-version VERSION|latest] [--runner-arch auto|x64|arm64] [--plan]
  runnerctl remove <runner> [--plan] [--yes] [--keep-remote] [--delete-dir]

Capacity and autoscale:
  runnerctl capacity [owner/repo|.] [--json]
  runnerctl autoscale enable [owner/repo|.]
  runnerctl autoscale status [owner/repo|.] [--json]
  runnerctl autoscale disable [owner/repo|.]
  runnerctl autoscale plan [owner/repo|.] [--json]
  runnerctl autoscale run-once [owner/repo|.] [--json]
  runnerctl autoscale history [--since DURATION] [--json]
  runnerctl autoscale explain --decision ID [--json]

Packages, CI and skills:
  runnerctl package detect
  runnerctl package ensure [--version VERSION|latest] [--arch auto|x64|arm64]
  runnerctl ci watch [owner/repo|.] [--sha SHA | --pr NUMERO] [--json] [--timeout SEGUNDOS] [--interval SEGUNDOS]
  runnerctl skills list
  runnerctl skills install [codex|copilot|claude|agents|all]

Platform:
  runnerctl platform-home
  runnerctl platform-authorize
  runnerctl platform-doctor
  runnerctl completion <bash|zsh|fish>
  runnerctl completion install <bash|zsh|fish>

Notas:
  - on-demand é a policy padrão.
  - "ensure ." inicia somente os runners habilitados mapeados ao repositório atual.
  - lifecycle runtime (ensure/start/stop/restart) nunca solicita sudo interativamente; rode "runnerctl platform-authorize" uma vez para autorizar mutações systemd.
  - "add" usa GitHub CLI autenticado, não persiste o registration token e o envia ao helper interno por stdin; o config.sh oficial recebe o token somente durante o registro.
  - use "runnerctl help <command>" para exemplos e flags de um comando.
EOF
}

command_help() {
  local topic="${1:-}"

  case "$topic" in
    ""|runnerctl|help)
      usage
      ;;
    init)
      cat <<'EOF'
Uso:
  runnerctl init

Bootstrap local idempotente. Cria ou ajusta configuração, dados, cache e state
nos diretórios XDG/RUNNER_*; não grava inventário da máquina no checkout Git.

Exemplos:
  runnerctl init
  XDG_CONFIG_HOME=/srv/runnerops/config runnerctl init
EOF
      ;;
    logs)
      cat <<'EOF'
Uso:
  runnerctl logs <runner|group:<group>|all> [--lines N] [--since DURATION] [--follow]

Mostra logs bounded por padrão. Runners systemd usam journalctl; runners legados
mostram o log local e o _diag mais recente quando disponível.

Flags:
  --lines N          número de linhas finais; default 200
  --since DURATION  filtra journal systemd desde duração positiva: 30s, 10m, 2h ou 1d
  --follow          acompanha novas linhas; exige um runner exato

`--follow` não aceita `group:*` ou `all`, porque o backend não multiplexa streams.

Exemplos:
  runnerctl logs my-api
  runnerctl logs my-api --lines 50
  runnerctl logs my-api --since 30m --follow
EOF
      ;;
    add)
      cat <<'EOF'
Uso:
  runnerctl add [owner/repo|.] [--profile PROFILE] [--group GROUP] [--labels CSV] [--name NAME]
                [--runner-version VERSION|latest] [--runner-arch auto|x64|arm64] [--plan]

Registra um runner local via GitHub CLI autenticado. O preflight administrativo
acontece antes de solicitar registration token. Falhas após registro preservam
PARTIAL/INCONCLUSIVE e orientam recuperação sem retry cego.

Flags:
  --plan                    preview read-only; não solicita token nem muta estado
  --profile PROFILE         auto, generic, node, python, flutter, java, go, dotnet
  --group GROUP             grupo operacional; default usa o slug do repo
  --labels CSV              labels GitHub; o nome local é sempre incluído
  --name NAME               nome local desejado; resolve colisões com sufixo
  --runner-version VERSION  versão actions/runner; default latest
  --runner-arch ARCH        auto, x64 ou arm64

Exemplos:
  runnerctl add .
  runnerctl add owner/repo --plan
  runnerctl add . --profile node --labels node,local-runner
EOF
      ;;
    remove)
      cat <<'EOF'
Uso:
  runnerctl remove <runner> [--plan] [--yes] [--keep-remote] [--delete-dir]

Remove um runner exato. all/group:* são rejeitados para preservar segurança.

Exemplos:
  runnerctl remove my-api --plan
  runnerctl remove my-api --yes
  runnerctl remove my-api --yes --keep-remote
EOF
      ;;
    start|stop|restart)
      cat <<EOF
Uso:
  runnerctl $topic <runner|group:<group>|all>

Lifecycle operacional. start/restart fecham com [SUMMARY] e [NEXT] curtos.

Exemplos:
  runnerctl $topic my-api
  runnerctl $topic group:my-team
EOF
      ;;
    status|health|doctor)
      cat <<EOF
Uso:
  runnerctl $topic [runner|group:<group>|all]

Diagnóstico read-only do estado local conhecido.

Exemplos:
  runnerctl $topic all
  runnerctl $topic my-api
EOF
      ;;
    overview|capacity|repo|ensure)
      cat <<EOF
Uso:
  runnerctl $topic [owner/repo|.]

Opera no repositório informado ou no repositório Git atual quando usado com ".".

Exemplos:
  runnerctl $topic .
  runnerctl $topic owner/repo
EOF
      ;;
    autoscale)
      cat <<'EOF'
Uso:
  runnerctl autoscale enable [owner/repo|.]
  runnerctl autoscale status [owner/repo|.] [--json]
  runnerctl autoscale disable [owner/repo|.]
  runnerctl autoscale plan [owner/repo|.] [--json]
  runnerctl autoscale run-once [owner/repo|.] [--json]
  runnerctl autoscale history [--since DURATION] [--json]
  runnerctl autoscale explain --decision ID [--json]

enable/disable gerenciam somente um timer systemd de usuário. status/plan são
read-only. run-once é governado por RUNNER_AUTOSCALE_ENABLED=true e executa
somente ações locais explicitamente suportadas.

Exemplos:
  runnerctl autoscale plan .
  runnerctl autoscale enable .
  runnerctl autoscale status .
  runnerctl autoscale disable .
  RUNNER_AUTOSCALE_ENABLED=true runnerctl autoscale run-once .
EOF
      ;;
    completion)
      cat <<'EOF'
Uso:
  runnerctl completion <bash|zsh|fish>
  runnerctl completion install <bash|zsh|fish>

Gera completion para stdout ou instala em um diretório padrão do shell.

Exemplos:
  runnerctl completion bash > ~/.local/share/bash-completion/completions/runnerctl
  runnerctl completion install fish
EOF
      ;;
    list|groups)
      cat <<EOF
Uso:
  runnerctl $topic

Consulta read-only do inventário local conhecido.

Exemplos:
  runnerctl $topic
EOF
      ;;
    plan|migrate)
      cat <<EOF
Uso:
  runnerctl $topic [runner|group:<group>|all]

Opera no boundary systemd/migration existente. "plan" é read-only; "migrate"
instala/reativa o serviço systemd para runners já registrados.

Exemplos:
  runnerctl $topic all
  runnerctl $topic my-api
EOF
      ;;
    on-demand|autostart)
      cat <<EOF
Uso:
  runnerctl $topic [runner|group:<group>|all]

Ajusta a política de boot systemd de runners já migrados sem alterar registration
remota. on-demand deixa boot desabilitado; autostart habilita boot e inicia.

Exemplos:
  runnerctl $topic my-api
  runnerctl $topic group:my-team
EOF
      ;;
    platform-home)
      cat <<'EOF'
Uso:
  runnerctl platform-home

Mostra o checkout RunnerOps resolvido pela CLI instalada.
EOF
      ;;
    platform-authorize)
      cat <<'EOF'
Uso:
  runnerctl platform-authorize

Instala/atualiza a autorização local para lifecycle systemd não interativo.
Rode em um terminal humano quando a máquina ainda não estiver autorizada.
EOF
      ;;
    platform-doctor)
      cat <<'EOF'
Uso:
  runnerctl platform-doctor

Diagnostica dependências e paths da plataforma local sem mutar runners.
EOF
      ;;
    package)
      cat <<'EOF'
Uso:
  runnerctl package detect
  runnerctl package ensure [--version VERSION|latest] [--arch auto|x64|arm64]

Detecta plataforma Linux suportada ou garante o pacote oficial actions/runner
no cache local.
EOF
      ;;
    --version|version)
      cat <<'EOF'
Uso:
  runnerctl --version

Mostra a versão da CLI pública instalada.
EOF
      ;;
    ci)
      cat <<'EOF'
Uso:
  runnerctl ci watch [owner/repo|.] [--sha SHA | --pr NUMERO] [--json] [--timeout SEGUNDOS] [--interval SEGUNDOS]

Aguarda workflows do SHA/PR alvo e preserva exit codes sem confundir falhas de CI
com falhas de infraestrutura.
EOF
      ;;
    skills)
      cat <<'EOF'
Uso:
  runnerctl skills list
  runnerctl skills install [codex|copilot|claude|agents|all]
EOF
      ;;
    *)
      die "help desconhecido: $topic"
      ;;
  esac
}

resolve_platform_home() {
  local candidate=""

  if [[ -n "${ACTIONS_RUNNERS_HOME:-}" ]]; then
    candidate="$ACTIONS_RUNNERS_HOME"
  elif [[ -f "$PLATFORM_HOME_FILE" ]]; then
    candidate="$(head -n 1 "$PLATFORM_HOME_FILE" | tr -d '\r\n')"
  elif [[ -x "$SCRIPT_DIR/runners.sh" ]]; then
    candidate="$SCRIPT_DIR"
  elif [[ -x "$HOME/actions-runners/runners.sh" ]]; then
    candidate="$HOME/actions-runners"
  fi

  [[ -n "$candidate" ]] || die "platform home não encontrado; rode ./install.sh no checkout ou defina ACTIONS_RUNNERS_HOME"
  candidate="$(realpath -m "$candidate")"
  [[ -x "$candidate/runners.sh" ]] || die "platform home inválido: $candidate"
  [[ -x "$candidate/runner-services.sh" ]] || die "runner-services.sh ausente em: $candidate"

  printf '%s\n' "$candidate"
}

PLATFORM_HOME="$(resolve_platform_home)"
RUNNEROPS_SYSTEMCTL_HELPER="${RUNNEROPS_SYSTEMCTL_HELPER:-/usr/local/libexec/runnerops-systemctl}"
export ACTIONS_RUNNERS_HOME="$PLATFORM_HOME"
# shellcheck source=/dev/null
source "$PLATFORM_HOME/runner-runtime-env.sh"
export RUNNERCTL_EXECUTABLE="$SCRIPT_PATH"

normalize_repo() {
  local value="${1:-}"
  value="${value%.git}"
  value="${value#git@github.com:}"
  value="${value#ssh://git@github.com/}"
  value="${value#https://github.com/}"
  value="${value#http://github.com/}"
  printf '%s\n' "${value,,}"
}

current_repo() {
  local repo=""

  if command -v gh >/dev/null 2>&1; then
    repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null || true)"
  fi

  if [[ -z "$repo" ]] && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    repo="$(git remote get-url origin 2>/dev/null || true)"
  fi

  repo="$(normalize_repo "$repo")"
  [[ "$repo" == */* ]] || return 1
  printf '%s\n' "$repo"
}

resolve_repo() {
  local requested="${1:-.}"
  local repo

  if [[ -z "$requested" || "$requested" == "." ]]; then
    repo="$(current_repo || true)"
  else
    repo="$(normalize_repo "$requested")"
  fi

  [[ "$repo" == */* ]] || die "não foi possível resolver owner/repo"
  printf '%s\n' "$repo"
}

canonical_repo() {
  local requested="$1"
  local key canonical

  key="$(normalize_repo "$requested")"
  canonical="$(gh repo view "$key" --json nameWithOwner --jq .nameWithOwner 2>/dev/null || true)"
  [[ "$canonical" == */* ]] || die "não foi possível resolver nameWithOwner canônico para $requested"
  printf '%s\n' "$canonical"
}

summary() {
  local status="$1" operation="$2"
  shift 2
  echo "[SUMMARY] status=$status operation=$operation${*:+ $*}"
}

next_action() {
  echo "[NEXT] $*"
}

progress_enabled() {
  [[ -t 1 && -z "${RUNNERCTL_NO_PROGRESS:-}" ]]
}

progress_step() {
  local step="$1" total="$2"
  shift 2
  progress_enabled || return 0
  printf '[%s/%s] %s\n' "$step" "$total" "$*" >&2
}

is_positive_integer() {
  [[ "${1:-}" =~ ^[1-9][0-9]*$ ]]
}

is_log_duration() {
  [[ "${1:-}" =~ ^[1-9][0-9]*[smhd]$ ]]
}

require_github_cli() {
  local operation="$1"

  if ! command -v gh >/dev/null 2>&1; then
    echo "[ERROR] status=failure operation=$operation reason=gh_missing" >&2
    next_action "instale GitHub CLI, rode 'gh auth login' e repita $operation" >&2
    die "GitHub CLI (gh) é obrigatório para $operation"
  fi

  if ! gh auth status >/dev/null 2>&1; then
    echo "[ERROR] status=failure operation=$operation reason=gh_unauthenticated" >&2
    next_action "rode 'gh auth login' e repita $operation" >&2
    die "GitHub CLI não está autenticado"
  fi
}

completion_words() {
  printf '%s\n' \
    help init list groups status health doctor logs \
    start stop restart plan migrate on-demand autostart \
    repo overview ensure add remove capacity autoscale \
    package ci skills platform-home platform-authorize platform-doctor \
    completion --version
}

generate_completion() {
  local shell="$1"
  local words
  words="$(completion_words)"

  case "$shell" in
    bash)
      cat <<EOF
_runnerctl_completion() {
  local cur
  cur="\${COMP_WORDS[COMP_CWORD]}"
  COMPREPLY=( \$(compgen -W "$words" -- "\$cur") )
}
complete -F _runnerctl_completion runnerctl
EOF
      ;;
    zsh)
      cat <<EOF
#compdef runnerctl
_runnerctl() {
  local -a commands
  commands=(${words//$'\n'/ })
  _describe 'runnerctl command' commands
}
_runnerctl "\$@"
EOF
      ;;
    fish)
      while read -r word; do
        [[ -n "$word" ]] || continue
        printf 'complete -c runnerctl -f -a %q\n' "$word"
      done <<< "$words"
      ;;
    *)
      die "completion aceita bash, zsh ou fish"
      ;;
  esac
}

install_completion() {
  local shell="$1"
  local target_dir target

  case "$shell" in
    bash)
      target_dir="${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions"
      target="$target_dir/runnerctl"
      ;;
    zsh)
      target_dir="${ZDOTDIR:-$HOME}/.zfunc"
      target="$target_dir/_runnerctl"
      ;;
    fish)
      target_dir="${XDG_CONFIG_HOME:-$HOME/.config}/fish/completions"
      target="$target_dir/runnerctl.fish"
      ;;
    *)
      die "completion install aceita bash, zsh ou fish"
      ;;
  esac

  mkdir -p "$target_dir"
  generate_completion "$shell" > "$target"
  echo "installed: $target"
}

completion_command() {
  local sub="${1:-}"

  case "$sub" in
    bash|zsh|fish)
      generate_completion "$sub"
      ;;
    install)
      shift || true
      [[ $# -ge 1 ]] || die "completion install exige bash, zsh ou fish"
      install_completion "$1"
      ;;
    ""|-h|--help|help)
      command_help completion
      ;;
    *)
      die "completion aceita bash, zsh, fish ou install"
      ;;
  esac
}

runner_logs() {
  local target="${1:-}"
  local lines="${RUNNER_LOG_LINES:-200}"
  local since=""
  local follow=0

  if [[ "$target" == "-h" || "$target" == "--help" || "$target" == "help" ]]; then
    command_help logs
    return 0
  fi
  [[ -n "$target" ]] || die "logs exige runner, group:<group> ou all"
  shift

  while (($#)); do
    case "$1" in
      --lines)
        lines="${2:-}"
        is_positive_integer "$lines" || die "--lines deve ser inteiro positivo"
        shift 2
        ;;
      --since)
        since="${2:-}"
        is_log_duration "$since" || die "--since deve usar duração como 30s, 10m, 2h ou 1d"
        shift 2
        ;;
      --follow)
        follow=1
        shift
        ;;
      -h|--help)
        command_help logs
        return 0
        ;;
      *)
        die "opção desconhecida em logs: $1"
        ;;
    esac
  done

  if [[ "$follow" -eq 1 && ( "$target" == "all" || "$target" == group:* ) ]]; then
    die "--follow exige um runner exato; group:* e all não são suportados"
  fi

  RUNNER_LOG_LINES="$lines" \
  RUNNER_LOG_SINCE="$since" \
  RUNNER_LOG_FOLLOW="$follow" \
    exec "$PLATFORM_HOME/runners.sh" logs "$target"
}

preflight_systemd_admin() {
  local runtime_dir="${RUNNER_SYSTEMD_RUNTIME_DIR:-/run/systemd/system}"

  command -v systemctl >/dev/null 2>&1 || {
    echo "[ERROR] status=failure operation=add reason=systemctl_missing" >&2
    next_action "habilite systemd/systemctl neste host antes de repetir runnerctl add" >&2
    die "runnerctl add exige systemctl antes de registrar o runner"
  }
  [[ -d "$runtime_dir" ]] || {
    echo "[ERROR] status=failure operation=add reason=systemd_inactive" >&2
    next_action "inicie um ambiente Linux com systemd ativo antes de repetir runnerctl add" >&2
    die "runnerctl add exige systemd ativo antes de registrar o runner"
  }

  if [[ "$(id -u)" -eq 0 ]]; then
    echo "[OK] preflight systemd/admin: root"
    return 0
  fi

  command -v sudo >/dev/null 2>&1 || {
    echo "[ERROR] status=failure operation=add reason=sudo_missing" >&2
    next_action "instale/configure sudo ou execute runnerctl add como root; nenhum registration token foi solicitado" >&2
    die "runnerctl add exige sudo para instalar o serviço systemd"
  }

  if sudo -n true >/dev/null 2>&1; then
    echo "[OK] preflight systemd/admin: sudo disponível"
    return 0
  fi

  if [[ -t 0 && -t 1 ]]; then
    echo "[AUTH] validando sudo antes de qualquer registro remoto..."
    sudo -v ||
      die "não foi possível validar sudo; nenhum registration token foi solicitado"
    echo "[OK] preflight systemd/admin: sudo validado"
    return 0
  fi

  echo "[ERROR] status=failure operation=add reason=sudo_interactive_required" >&2
  next_action "execute o próprio 'runnerctl add ...' em um terminal humano, ou rode 'sudo -v' na mesma sessão; nenhum registration token foi solicitado" >&2
  die "runnerctl add precisa de sudo interativo para instalar o serviço systemd; execute o próprio 'runnerctl add ...' em um terminal humano, ou rode 'sudo -v' na mesma sessão que executará o add; nenhum registration token foi solicitado"
}

repo_slug() {
  local repo="$1"
  printf '%s\n' "${repo##*/}" | tr '[:upper:]' '[:lower:]'
}

runners_for_repo() {
  local repo="$1"
  [[ -f "$RUNNERS_CONFIG" ]] || die "registry não encontrado: $RUNNERS_CONFIG"

  awk -F'|' -v wanted="$repo" '
    /^[[:space:]]*#/ || NF < 5 { next }
    {
      name=$1
      mapped=$4
      enabled=$5
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", mapped)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", enabled)
      if (tolower(mapped) == tolower(wanted) && tolower(enabled) != "false") {
        print name
      }
    }
  ' "$RUNNERS_CONFIG"
}

ensure_repo() {
  local repo="$1"
  local runner
  local -a runners=()

  mapfile -t runners < <(runners_for_repo "$repo")
  [[ "${#runners[@]}" -gt 0 ]] || die "nenhum runner habilitado mapeado para $repo"

  echo "Repo: $repo"
  for runner in "${runners[@]}"; do
    "$PLATFORM_HOME/runners.sh" start "$runner"
  done

  for runner in "${runners[@]}"; do
    "$PLATFORM_HOME/runners.sh" status "$runner"
    "$PLATFORM_HOME/runners.sh" health "$runner"
  done
}

infer_profile_from_dir() {
  local dir="$1"

  if [[ -f "$dir/pubspec.yaml" ]]; then
    echo flutter
  elif [[ -f "$dir/package.json" ]]; then
    echo node
  elif [[ -f "$dir/pyproject.toml" || -f "$dir/requirements.txt" || -f "$dir/poetry.lock" ]]; then
    echo python
  elif [[ -f "$dir/pom.xml" || -f "$dir/build.gradle" || -f "$dir/build.gradle.kts" ]]; then
    echo java
  elif [[ -f "$dir/go.mod" ]]; then
    echo go
  elif find "$dir" -maxdepth 2 \( -name '*.sln' -o -name '*.csproj' \) -print -quit 2>/dev/null | grep -q .; then
    echo dotnet
  else
    echo generic
  fi
}

normalize_runner_slug() {
  local value="${1,,}"
  value="$(printf '%s' "$value" | tr -c 'a-z0-9._-' '-')"
  value="${value#-}"
  value="${value%-}"
  [[ -n "$value" ]] || value="generic"
  printf '%s\n' "$value"
}

append_csv_label_for_plan() {
  local current_labels="$1"
  local required_label="$2"
  local result=""
  local item
  local found=0
  local -a label_items=()

  IFS=',' read -r -a label_items <<< "$current_labels"
  for item in "${label_items[@]}"; do
    item="$(trim_value "$item")"
    [[ -n "$item" ]] || continue
    if [[ "${item,,}" == "${required_label,,}" ]]; then
      found=1
    fi
    result+="${result:+,}$item"
  done

  if [[ "$found" -eq 0 ]]; then
    result+="${result:+,}$required_label"
  fi

  printf '%s\n' "$result"
}

runner_name_exists_for_add() {
  local runner_name="$1"

  if [[ -f "$RUNNERS_CONFIG" ]] &&
      awk -F '|' -v runner_name="$runner_name" '$1 == runner_name { found=1 } END { exit(found ? 0 : 1) }' "$RUNNERS_CONFIG"; then
    return 0
  fi

  [[ -e "$RUNNER_DATA_ROOT/$runner_name" ]]
}

next_available_runner_name_for_add() {
  local requested_name="$1"
  local candidate="$requested_name"
  local index=2

  if ! runner_name_exists_for_add "$candidate"; then
    printf '%s\n' "$candidate"
    return 0
  fi

  while runner_name_exists_for_add "${requested_name}-${index}"; do
    index=$((index + 1))
  done

  printf '%s\n' "${requested_name}-${index}"
}

resolve_runner_package_spec() {
  local requested_version="$1"
  local requested_arch="$2"
  local platform detected_os detected_arch resolved_arch tag resolved_version

  [[ -x "$PLATFORM_HOME/runner-package.sh" ]] ||
    die "runner-package.sh ausente ou não executável"

  platform="$("$PLATFORM_HOME/runner-package.sh" detect)"
  IFS='|' read -r detected_os detected_arch <<< "$platform"
  resolved_arch="$requested_arch"
  [[ "$resolved_arch" == "auto" ]] && resolved_arch="$detected_arch"
  case "$resolved_arch" in
    x64|arm64) ;;
    *) die "arch inválida: $requested_arch" ;;
  esac

  if [[ "$requested_version" == "latest" ]]; then
    tag="$(gh api repos/actions/runner/releases/latest --jq .tag_name)"
    [[ -n "$tag" ]] || die "não foi possível resolver a release latest de actions/runner"
    resolved_version="${tag#v}"
  else
    resolved_version="${requested_version#v}"
  fi

  printf '%s|%s|%s\n' "$detected_os" "$resolved_arch" "$resolved_version"
}

resolve_add_runner_spec() {
  local repo_arg="$1"
  local repo="$2"
  local slug="$3"
  local source_dir="$4"
  local profile="$5"
  local group="$6"
  local labels="$7"
  local name="$8"
  local requested_version="$9"
  local requested_arch="${10}"
  local current requested_name effective_name effective_group effective_labels package_spec package_os package_arch package_version

  if [[ "$profile" == "auto" ]]; then
    if [[ "$repo_arg" == "." || -z "$repo_arg" ]]; then
      profile="$(infer_profile_from_dir "$source_dir")"
    else
      current="$(current_repo || true)"
      if [[ "$(normalize_repo "$current")" == "$(normalize_repo "$repo")" ]]; then
        profile="$(infer_profile_from_dir "$source_dir")"
      else
        profile="generic"
      fi
    fi
  fi

  requested_name="$(normalize_runner_slug "${name:-$slug}")"
  effective_name="$(next_available_runner_name_for_add "$requested_name")"
  if [[ "$group" == "auto" || -z "$group" ]]; then
    effective_group="$(normalize_runner_slug "$slug")"
  else
    effective_group="$(normalize_runner_slug "$group")"
  fi

  if [[ -z "$labels" ]]; then
    if [[ "$profile" == "generic" ]]; then
      labels="$slug,local-runner"
    else
      labels="$profile,$slug,local-runner"
    fi
  fi
  effective_labels="$(append_csv_label_for_plan "$labels" "$effective_name")"

  package_spec="$(resolve_runner_package_spec "$requested_version" "$requested_arch")"
  IFS='|' read -r package_os package_arch package_version <<< "$package_spec"

  printf '%s|%s|%s|%s|%s|%s|%s\n' \
    "$profile" "$effective_group" "$effective_labels" "$effective_name" "$package_version" "$package_arch" "$package_os"
}

add_runner() {
  local repo_arg="."
  local profile="auto"
  local group="auto"
  local labels=""
  local name=""
  local runner_version="latest"
  local runner_arch="auto"
  local plan_only=0
  local repo slug source_dir token output runner_name
  local spec runner_os requested_runner_version requested_runner_arch
  local -a args=()

  if [[ $# -gt 0 && "$1" != --* ]]; then
    repo_arg="$1"
    shift
  fi

  while (($#)); do
    case "$1" in
      --profile)
        profile="${2:-}"
        shift 2
        ;;
      --group)
        group="${2:-}"
        shift 2
        ;;
      --labels)
        labels="${2:-}"
        shift 2
        ;;
      --name)
        name="${2:-}"
        shift 2
        ;;
      --runner-version)
        runner_version="${2:-}"
        shift 2
        ;;
      --runner-arch)
        runner_arch="${2:-}"
        shift 2
        ;;
      --plan)
        plan_only=1
        shift
        ;;
      *)
        die "opção desconhecida em add: $1"
        ;;
    esac
  done

  if [[ "$plan_only" -eq 0 ]]; then
    progress_step 1 6 "resolving repository and runner spec"
  fi
  repo="$(resolve_repo "$repo_arg")"

  if [[ "$plan_only" -eq 0 ]]; then
    progress_step 2 6 "checking GitHub CLI and runner package"
  fi
  require_github_cli "runnerctl add"
  repo="$(canonical_repo "$repo")"
  slug="$(repo_slug "$repo")"

  source_dir="$(pwd)"
  requested_runner_version="$runner_version"
  requested_runner_arch="$runner_arch"
  spec="$(resolve_add_runner_spec "$repo_arg" "$repo" "$slug" "$source_dir" "$profile" "$group" "$labels" "$name" "$runner_version" "$runner_arch")"
  IFS='|' read -r profile group labels name runner_version runner_arch runner_os <<< "$spec"

  if [[ "$plan_only" -eq 1 ]]; then
    echo "Add plan:"
    echo "- operation: PREVIEW"
    echo "- repository: $repo"
    echo "- source directory: $source_dir"
    echo "- profile: $profile"
    echo "- group: $group"
    echo "- runner name: $name"
    echo "- labels: $labels"
    echo "- runner version: $runner_version (requested: $requested_runner_version)"
    echo "- runner platform: $runner_os/$runner_arch (requested arch: $requested_runner_arch)"
    echo "- remote registration: NOT REQUESTED"
    echo "- filesystem: NO MUTATION"
    echo "- systemd: NO MUTATION"
    echo "- registry: NO MUTATION"
    echo "Read-only plan: no registration-token request, runner directory, systemd unit, or registry write was performed."
    next_action "run the same command without --plan to apply"
    summary "success" "add-plan" "repo=$repo runner=$name"
    return 0
  fi

  progress_step 3 6 "checking systemd/admin access before remote registration"
  preflight_systemd_admin

  args=(
    --repo-url "https://github.com/$repo"
    --token-stdin
    --profile "$profile"
    --group "$group"
    --labels "$labels"
    --runner-version "$runner_version"
    --runner-arch "$runner_arch"
    --name "$name"
  )

  echo "Registrando runner para $repo"
  echo "Profile: $profile"
  echo "Group: $group"
  echo "Labels: $labels"
  echo "Runner version: $runner_version (requested: $requested_runner_version)"
  echo "Runner arch: $runner_arch (requested: $requested_runner_arch)"

  progress_step 4 6 "requesting short-lived registration token"
  token="$(gh api --method POST "repos/$repo/actions/runners/registration-token" --jq .token)"
  [[ -n "$token" ]] || die "GitHub não retornou registration token"

  progress_step 5 6 "configuring local runner"
  if ! output="$(printf '%s\n' "$token" | "$PLATFORM_HOME/configure-runner.sh" "${args[@]}" 2>&1)"; then
    unset token
    printf '%s\n' "$output" >&2
    runner_name="$(printf '%s\n' "$output" | awk -F': ' '/^Runner local: /{print $2}' | tail -n 1)"
    echo "[INCONCLUSIVE] runner=${runner_name:-unknown} repo=$repo phase=configure remote-registration=unknown" >&2
    summary "inconclusive" "add" "runner=${runner_name:-unknown} repo=$repo phase=configure remote-registration=unknown" >&2
    if [[ -n "$runner_name" ]]; then
      echo "[RECOVERY] runnerctl doctor $runner_name" >&2
    fi
    echo "[RECOVERY] verifique o registro remoto antes de repetir runnerctl add" >&2
    return 1
  fi
  unset token

  printf '%s\n' "$output"
  runner_name="$(printf '%s\n' "$output" | awk -F': ' '/^Nome local: /{print $2}' | tail -n 1)"
  [[ -n "$runner_name" ]] || die "runner foi configurado, mas o nome local não pôde ser resolvido"

  progress_step 6 6 "migrating and validating lifecycle"
  if ! "$PLATFORM_HOME/runner-services.sh" migrate "$runner_name"; then
    echo "[PARTIAL] runner=$runner_name repo=$repo phase=systemd-migrate remote-registration=present" >&2
    summary "partial" "add" "runner=$runner_name repo=$repo phase=systemd-migrate" >&2
    echo "[RECOVERY] runnerctl doctor $runner_name" >&2
    echo "[RECOVERY] runnerctl migrate $runner_name" >&2
    return 1
  fi

  if ! "$PLATFORM_HOME/runners.sh" doctor "$runner_name"; then
    echo "[PARTIAL] runner=$runner_name repo=$repo phase=post-migrate-doctor remote-registration=present" >&2
    summary "partial" "add" "runner=$runner_name repo=$repo phase=post-migrate-doctor" >&2
    echo "[RECOVERY] runnerctl doctor $runner_name" >&2
    return 1
  fi

  "$PLATFORM_HOME/runners.sh" health "$runner_name"

  echo "[OK] runner=$runner_name repo=$repo policy=$RUNNER_BOOT_POLICY"
  summary "success" "add" "runner=$runner_name repo=$repo policy=$RUNNER_BOOT_POLICY"
  if [[ "$RUNNER_BOOT_POLICY" == "on-demand" ]]; then
    next_action "optional now: runnerctl start $runner_name"
  else
    next_action "runnerctl status $runner_name && runnerctl health $runner_name"
  fi
}

trim_value() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

runner_record() {
  local runner="$1"
  [[ -f "$RUNNERS_CONFIG" ]] || die "registry não encontrado: $RUNNERS_CONFIG"

  awk -F'|' -v wanted="$runner" '
    /^[[:space:]]*#/ || NF < 5 { next }
    {
      name=$1
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
      if (name == wanted) print
    }
  ' "$RUNNERS_CONFIG"
}

runner_metadata_value() {
  local file="$1" key="$2"
  [[ -f "$file" ]] || return 1

  case "$key" in
    agentId)
      grep -oE '"agentId"[[:space:]]*:[[:space:]]*[0-9]+' "$file" 2>/dev/null |
        head -n 1 |
        grep -oE '[0-9]+$'
      ;;
    agentName)
      grep -oE '"agentName"[[:space:]]*:[[:space:]]*"[^"]*"' "$file" 2>/dev/null |
        head -n 1 |
        sed -E 's/^.*"agentName"[[:space:]]*:[[:space:]]*"([^"]*)".*$/\1/'
      ;;
    *)
      return 1
      ;;
  esac
}

runner_local_unit() {
  local path="$1"
  local unit working_dir

  if [[ -f "$path/.service" ]]; then
    unit="$(tr -d '[:space:]' < "$path/.service")"
    [[ -n "$unit" ]] && {
      printf '%s\n' "$unit"
      return 0
    }
  fi

  if command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
    while read -r unit; do
      [[ -n "$unit" ]] || continue
      working_dir="$(systemctl show "$unit" --property=WorkingDirectory --value 2>/dev/null || true)"
      if [[ "$working_dir" == "$path" ]]; then
        printf '%s\n' "$unit"
        return 0
      fi
    done < <(
      systemctl list-unit-files 'actions.runner.*.service' --no-legend --no-pager 2>/dev/null |
        awk '{print $1}'
    )
  fi

  printf '%s\n' "unknown"
}

remove_registry_entry() {
  local runner="$1"
  local tmp

  tmp="$(mktemp)"
  awk -F'|' -v wanted="$runner" '
    /^[[:space:]]*#/ { print; next }
    {
      name=$1
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
      if (name != wanted) print
    }
  ' "$RUNNERS_CONFIG" > "$tmp"
  chmod --reference="$RUNNERS_CONFIG" "$tmp" 2>/dev/null || chmod 600 "$tmp"
  mv "$tmp" "$RUNNERS_CONFIG"
}

validate_runner_delete_path() {
  local path="$1"
  local safe_path data_root_real platform_home_real home_real

  safe_path="$(realpath -m "$path")"
  data_root_real="$(realpath -m "$RUNNER_DATA_ROOT")"
  platform_home_real="$(realpath -m "$PLATFORM_HOME")"
  home_real="$(realpath -m "$HOME")"

  [[ "$safe_path" != "/" ]] || die "recusando apagar /"
  [[ "$safe_path" != "$home_real" ]] || die "recusando apagar HOME"
  [[ "$safe_path" != "$platform_home_real" ]] || die "recusando apagar platform home"
  [[ "$safe_path" != "$data_root_real" ]] || die "recusando apagar RUNNER_DATA_ROOT"
  [[ -f "$safe_path/.runner" || -x "$safe_path/config.sh" ]] ||
    die "recusando apagar diretório sem marcador de GitHub Runner: $safe_path"

  printf '%s\n' "$safe_path"
}

remove_runner() {
  local runner=""
  local plan_only=0
  local yes=0
  local keep_remote=0
  local delete_dir=0
  local record count path profile repo enabled group rest unit
  local runner_file remote_id remote_name remote_row="" remote_status=""
  local safe_delete_path=""

  [[ $# -ge 1 ]] || die "remove exige o nome exato de um runner"
  runner="$1"
  shift

  [[ "$runner" != "all" && "$runner" != group:* ]] ||
    die "remove aceita somente um runner exato; all/group não são permitidos"

  while (($#)); do
    case "$1" in
      --plan)
        plan_only=1
        shift
        ;;
      --yes)
        yes=1
        shift
        ;;
      --keep-remote)
        keep_remote=1
        shift
        ;;
      --delete-dir)
        delete_dir=1
        shift
        ;;
      *)
        die "opção desconhecida em remove: $1"
        ;;
    esac
  done

  [[ "$delete_dir" -eq 0 || "$keep_remote" -eq 0 ]] ||
    die "--delete-dir não pode ser combinado com --keep-remote"

  record="$(runner_record "$runner")"
  count="$(printf '%s\n' "$record" | awk 'NF { count++ } END { print count+0 }')"
  [[ "$count" -eq 1 ]] ||
    die "esperava exatamente 1 entrada para '$runner' no registry; encontrei $count"

  IFS='|' read -r _name path profile repo enabled group rest <<< "$record"
  path="$(trim_value "$path")"
  repo="$(normalize_repo "$(trim_value "$repo")")"
  profile="$(trim_value "$profile")"
  group="$(trim_value "$group")"
  enabled="$(trim_value "$enabled")"

  [[ -n "$path" ]] || die "$runner: path ausente no registry"
  path="$(realpath -m "$path")"
  runner_file="$path/.runner"
  unit="$(runner_local_unit "$path")"

  remote_id="$(runner_metadata_value "$runner_file" agentId || true)"
  remote_name="$(runner_metadata_value "$runner_file" agentName || true)"

  if [[ "$delete_dir" -eq 1 ]]; then
    safe_delete_path="$(validate_runner_delete_path "$path")"
  fi

  echo "Removal plan:"
  echo "- runner: $runner"
  echo "- repo: ${repo:-unknown}"
  echo "- path: $path"
  echo "- profile: ${profile:-generic}"
  echo "- group: ${group:-unknown}"
  echo "- systemd unit: $unit"
  echo "- local service: STOP + UNINSTALL"
  if [[ "$keep_remote" -eq 1 ]]; then
    echo "- GitHub registration: KEEP"
  else
    echo "- GitHub registration: REMOVE"
    echo "- remote runner: ${remote_name:-unknown}"
    echo "- remote id: ${remote_id:-unknown}"
  fi
  echo "- registry entry: REMOVE"
  if [[ "$delete_dir" -eq 1 ]]; then
    echo "- local directory: DELETE ($safe_delete_path)"
  else
    echo "- local directory: KEEP"
  fi

  if [[ "$plan_only" -eq 1 ]]; then
    summary "success" "remove-plan" "runner=$runner repo=${repo:-unknown}"
    return 0
  fi

  if [[ "$yes" -ne 1 ]]; then
    echo
    echo "Nenhuma alteração aplicada."
    echo "Revise o plano e rode novamente com --yes."
    summary "success" "remove-plan" "runner=$runner repo=${repo:-unknown}"
    return 0
  fi

  if [[ "$keep_remote" -eq 0 ]]; then
    [[ "$repo" == */* ]] ||
      die "$runner: repo inválido para remoção remota; use --keep-remote para detach local"
    [[ "$remote_id" =~ ^[0-9]+$ ]] ||
      die "$runner: agentId não encontrado em $runner_file; use --keep-remote para detach local"
    [[ -n "$remote_name" ]] ||
      die "$runner: agentName não encontrado em $runner_file; use --keep-remote para detach local"

    require_github_cli "runnerctl remove"

    remote_row="$(
      gh api "repos/$repo/actions/runners" --paginate \
        --jq ".runners[] | select(.id == $remote_id) | [.id, .name, .status] | @tsv"
    )"

    if [[ -n "$remote_row" ]]; then
      IFS=$'\t' read -r _remote_id checked_name remote_status <<< "$remote_row"
      [[ "$checked_name" == "$remote_name" ]] ||
        die "proteção acionada: remote id $remote_id pertence a '$checked_name', esperado '$remote_name'"
      echo "[CHECK] GitHub runner=$checked_name id=$remote_id status=$remote_status"
    else
      echo "[INFO] registration remota já não existe: repo=$repo id=$remote_id"
    fi
  fi

  if ! "$PLATFORM_HOME/runners.sh" stop "$runner"; then
    summary "failure" "remove" "runner=$runner phase=stop" >&2
    next_action "rode 'runnerctl doctor $runner' antes de repetir a remoção" >&2
    return 1
  fi
  if ! "$PLATFORM_HOME/runner-services.sh" uninstall "$runner"; then
    summary "partial" "remove" "runner=$runner phase=systemd-uninstall local-service=unknown" >&2
    next_action "rode 'runnerctl doctor $runner' e depois 'runnerctl remove $runner --yes' quando a evidência estiver clara" >&2
    return 1
  fi

  if [[ "$keep_remote" -eq 0 && -n "$remote_row" ]]; then
    if ! gh api --method DELETE "repos/$repo/actions/runners/$remote_id"; then
      summary "partial" "remove" "runner=$runner phase=remote-delete local-service=uninstalled registry=present" >&2
      next_action "verifique o runner remoto no GitHub antes de repetir 'runnerctl remove $runner --yes'" >&2
      return 1
    fi
    echo "[OK] registration remota removida: $repo/$remote_name ($remote_id)"
  fi

  if ! remove_registry_entry "$runner"; then
    summary "partial" "remove" "runner=$runner phase=registry-remove local-service=uninstalled" >&2
    next_action "corrija o registry local em $RUNNERS_CONFIG antes de repetir qualquer remoção" >&2
    return 1
  fi
  echo "[OK] registry removido: $runner"

  if [[ "$delete_dir" -eq 1 ]]; then
    if ! rm -rf -- "$safe_delete_path"; then
      summary "partial" "remove" "runner=$runner phase=delete-dir registry=removed" >&2
      next_action "remova manualmente o diretório validado quando não houver processos usando-o: $safe_delete_path" >&2
      return 1
    fi
    echo "[OK] diretório local removido: $safe_delete_path"
  else
    echo "[KEEP] diretório local preservado: $path"
  fi

  echo "[OK] runner removido da plataforma local: $runner"
  summary "success" "remove" "runner=$runner repo=${repo:-unknown}"
  next_action "runnerctl status all"
}

lifecycle_mutation() {
  local cmd="$1"
  shift
  local target="${1:-}"
  local rc

  if "$PLATFORM_HOME/runners.sh" "$cmd" "$@"; then
    summary "success" "$cmd" "target=$target"
    next_action "runnerctl status $target && runnerctl health $target"
    return 0
  fi

  rc=$?
  if [[ "$rc" -eq 3 ]]; then
    summary "inconclusive" "$cmd" "target=$target" >&2
  else
    summary "failure" "$cmd" "target=$target" >&2
  fi
  next_action "runnerctl doctor $target" >&2
  return "$rc"
}

ci_watch() {
  local repo_arg="."
  local repo current sha=""
  local has_ref=0
  local arg
  local -a args=()

  if [[ $# -gt 0 && "$1" != --* ]]; then
    repo_arg="$1"
    shift
  fi

  repo="$(resolve_repo "$repo_arg")"

  for arg in "$@"; do
    if [[ "$arg" == "--sha" || "$arg" == "--pr" ]]; then
      has_ref=1
      break
    fi
  done

  if [[ "$has_ref" -eq 0 ]]; then
    current="$(current_repo || true)"
    [[ "$current" == "$repo" ]] ||
      die "ci watch exige --sha ou --pr quando o alvo não é o repositório Git atual"
    sha="$(git rev-parse HEAD 2>/dev/null || true)"
    [[ "$sha" =~ ^[0-9A-Fa-f]{7,64}$ ]] ||
      die "não foi possível resolver o SHA atual; informe --sha ou --pr"
    args+=(--sha "$sha")
  fi

  [[ -f "$PLATFORM_HOME/ci-watch.sh" ]] ||
    die "ci-watch.sh ausente em: $PLATFORM_HOME"

  exec bash "$PLATFORM_HOME/ci-watch.sh" --repo "$repo" "${args[@]}" "$@"
}

platform_doctor() {
  local rc=0
  echo "platform_home=$PLATFORM_HOME"
  echo "runners_config=$RUNNERS_CONFIG"
  echo "runner_data_root=$RUNNER_DATA_ROOT"
  echo "runner_cache_root=$RUNNER_CACHE_ROOT"
  echo "runner_state_root=$RUNNER_STATE_ROOT"
  echo "boot_policy=$RUNNER_BOOT_POLICY"

  for cmd in bash git tar sha256sum systemctl; do
    if command -v "$cmd" >/dev/null 2>&1; then
      echo "[OK] command=$cmd"
    else
      echo "[MISSING] command=$cmd"
      rc=1
    fi
  done

  if [[ -x "$PLATFORM_HOME/runner-package.sh" ]]; then
    package_platform="$("$PLATFORM_HOME/runner-package.sh" detect 2>/dev/null || true)"
    if [[ -n "$package_platform" ]]; then
      echo "[OK] runner_package_platform=$package_platform"
    else
      echo "[MISSING] runner_package_platform=unsupported"
      rc=1
    fi
  else
    echo "[MISSING] runner-package.sh"
    rc=1
  fi

  if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then
      echo "[OK] gh=authenticated"
    else
      echo "[WARN] gh=installed-not-authenticated"
    fi
  else
    echo "[WARN] gh=missing add=unavailable"
  fi

  if command -v python3 >/dev/null 2>&1; then
    python_version="$(python3 -c 'import sys; print(".".join(map(str, sys.version_info[:3])))' 2>/dev/null || true)"
    if python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
      echo "[OK] capacity_runtime=python3 version=${python_version:-unknown}"
      if python3 -B -c 'import sqlite3; raise SystemExit(0 if sqlite3.sqlite_version_info >= (3, 24, 0) else 1)' >/dev/null 2>&1; then
        echo "[OK] autoscale_audit_runtime=python3-sqlite3"
      else
        echo "[WARN] autoscale_audit_runtime=sqlite3-missing-or-old required='SQLite>=3.24' autoscale_audit=unavailable"
      fi
    else
      echo "[WARN] capacity_runtime=python3-too-old version=${python_version:-unknown} required='>=3.8'"
    fi
  else
    echo "[WARN] capacity_runtime=python3-missing capacity=unavailable"
  fi

  if [[ -d /run/systemd/system ]]; then
    echo "[OK] systemd=active"
  else
    echo "[MISSING] systemd=inactive"
    rc=1
  fi

  if [[ "$(id -u)" -eq 0 ]]; then
    echo "[OK] runtime_privileges=root"
  elif command -v sudo >/dev/null 2>&1 &&
      [[ -x "$RUNNEROPS_SYSTEMCTL_HELPER" ]] &&
      sudo -n "$RUNNEROPS_SYSTEMCTL_HELPER" check >/dev/null 2>&1; then
    echo "[OK] runtime_privileges=non-interactive"
  else
    echo "[WARN] runtime_privileges=not-authorized action='runnerctl platform-authorize'"
  fi

  [[ -f "$RUNNERS_CONFIG" ]] && echo "[OK] registry=present" || echo "[WARN] registry=missing run='runnerctl init'"
  return "$rc"
}

init_machine() {
  if ! progress_enabled; then
    exec "$PLATFORM_HOME/init-machine-config.sh" "$@"
  fi

  progress_step 1 3 "checking platform home"
  [[ -x "$PLATFORM_HOME/init-machine-config.sh" ]] ||
    die "init-machine-config.sh ausente em: $PLATFORM_HOME"

  progress_step 2 3 "initializing config, data, cache and state roots"
  "$PLATFORM_HOME/init-machine-config.sh" "$@"

  progress_step 3 3 "bootstrap finished"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  help|-h|--help)
    command_help "${1:-}"
    ;;
  platform-home)
    printf '%s\n' "$PLATFORM_HOME"
    ;;
  platform-authorize)
    [[ -f "$PLATFORM_HOME/authorize-runtime.sh" ]] ||
      die "authorize-runtime.sh ausente em: $PLATFORM_HOME"
    exec bash "$PLATFORM_HOME/authorize-runtime.sh" "$@"
    ;;
  platform-doctor)
    platform_doctor
    ;;
  init)
    init_machine "$@"
    ;;
  list|groups)
    exec "$PLATFORM_HOME/runners.sh" "$cmd" "$@"
    ;;
  status|health|doctor)
    target="${1:-all}"
    exec "$PLATFORM_HOME/runners.sh" "$cmd" "$target"
    ;;
  start|stop|restart)
    [[ $# -ge 1 ]] || die "$cmd exige runner, group:<group> ou all"
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then
      command_help "$cmd"
    elif [[ "$cmd" == "start" || "$cmd" == "restart" ]]; then
      lifecycle_mutation "$cmd" "$@"
    else
      exec "$PLATFORM_HOME/runners.sh" "$cmd" "$@"
    fi
    ;;
  logs)
    runner_logs "$@"
    ;;
  plan|migrate|on-demand|autostart)
    target="${1:-all}"
    exec "$PLATFORM_HOME/runner-services.sh" "$cmd" "$target"
    ;;
  repo)
    resolve_repo "${1:-.}"
    ;;
  overview)
    [[ -f "$PLATFORM_HOME/overview.py" ]] || die "overview.py ausente em: $PLATFORM_HOME"
    command -v python3 >/dev/null 2>&1 || die "overview exige python3 3.8+"
    python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1 ||
      die "overview exige python3 3.8+"
    exec python3 -B "$PLATFORM_HOME/overview.py" "$@"
    ;;
  capacity|autoscale)
    if [[ "$cmd" == "autoscale" ]]; then
      sub="${1:-}"
      case "$sub" in
        enable|disable|status|plan|run-once|history|explain) ;;
        *) die "autoscale aceita enable, disable, status, plan, run-once, history ou explain" ;;
      esac
      shift
      if [[ "$sub" == "enable" || "$sub" == "disable" || "$sub" == "status" ]]; then
        [[ -f "$PLATFORM_HOME/autoscale_scheduler.py" ]] || die "autoscale_scheduler.py ausente em: $PLATFORM_HOME"
        command -v python3 >/dev/null 2>&1 || die "autoscale $sub exige python3 3.8+"
        python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1 ||
          die "autoscale $sub exige python3 3.8+"
        exec python3 -B "$PLATFORM_HOME/autoscale_scheduler.py" "$sub" "$@"
      fi
      if [[ "$sub" == "plan" ]]; then
        [[ -f "$PLATFORM_HOME/autoscale_planner.py" ]] || die "autoscale_planner.py ausente em: $PLATFORM_HOME"
        command -v python3 >/dev/null 2>&1 || die "autoscale plan exige python3 3.8+"
        python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1 ||
          die "autoscale plan exige python3 3.8+"
        exec python3 -B "$PLATFORM_HOME/autoscale_planner.py" "$@"
      fi
      if [[ "$sub" == "run-once" ]]; then
        [[ -f "$PLATFORM_HOME/autoscale_controller.py" ]] || die "autoscale_controller.py ausente em: $PLATFORM_HOME"
        command -v python3 >/dev/null 2>&1 || die "autoscale run-once exige python3 3.8+ com módulo sqlite3"
        python3 -c 'import sqlite3,sys; raise SystemExit(0 if sys.version_info >= (3, 8) and sqlite3.sqlite_version_info >= (3, 24, 0) else 1)' >/dev/null 2>&1 ||
          die "autoscale run-once exige python3 3.8+ com módulo sqlite3/SQLite 3.24+"
        exec python3 -B "$PLATFORM_HOME/autoscale_controller.py" "$@"
      fi
      if [[ "$sub" != "status" ]]; then
        [[ -f "$PLATFORM_HOME/autoscale_audit.py" ]] || die "autoscale_audit.py ausente em: $PLATFORM_HOME"
        command -v python3 >/dev/null 2>&1 || die "autoscale audit exige python3 3.8+ com módulo sqlite3"
        python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1 ||
          die "autoscale audit exige python3 3.8+ com módulo sqlite3"
        exec python3 -B "$PLATFORM_HOME/autoscale_audit.py" "$sub" "$@"
      fi
    fi
    [[ -f "$PLATFORM_HOME/capacity.py" ]] || die "capacity.py ausente em: $PLATFORM_HOME"
    command -v python3 >/dev/null 2>&1 || die "capacity exige python3 3.8+"
    python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1 ||
      die "capacity exige python3 3.8+"
    exec python3 -B "$PLATFORM_HOME/capacity.py" "$@"
    ;;
  ensure)
    repo="$(resolve_repo "${1:-.}")"
    ensure_repo "$repo"
    ;;
  package)
    sub="${1:-detect}"
    shift || true
    case "$sub" in
      detect|ensure)
        exec "$PLATFORM_HOME/runner-package.sh" "$sub" "$@"
        ;;
      *)
        die "package aceita detect ou ensure"
        ;;
    esac
    ;;
  ci)
    sub="${1:-}"
    shift || true
    case "$sub" in
      watch)
        ci_watch "$@"
        ;;
      *)
        die "ci aceita watch"
        ;;
    esac
    ;;
  add)
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then
      command_help add
    else
      add_runner "$@"
    fi
    ;;
  remove)
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || "${1:-}" == "help" ]]; then
      command_help remove
    else
      remove_runner "$@"
    fi
    ;;
  skills)
    sub="${1:-list}"
    shift || true
    case "$sub" in
      list)
        exec "$PLATFORM_HOME/install-agent-skills.sh" --list
        ;;
      install)
        tool="${1:-all}"
        exec "$PLATFORM_HOME/install-agent-skills.sh" --tool "$tool"
        ;;
      *)
        die "skills aceita list ou install"
        ;;
    esac
    ;;
  completion)
    completion_command "$@"
    ;;
  *)
    die "comando desconhecido: $cmd"
    ;;
esac
