#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/actions-runners"
PLATFORM_HOME_FILE="$CONFIG_HOME/platform-home"

die() {
  echo "ERRO: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
runnerctl — local GitHub Actions runner control plane

Uso:
  runnerctl init
  runnerctl list
  runnerctl groups
  runnerctl status [runner|group:<group>|all]
  runnerctl health [runner|group:<group>|all]
  runnerctl doctor [runner|group:<group>|all]
  runnerctl start <runner|group:<group>|all>
  runnerctl stop <runner|group:<group>|all>
  runnerctl restart <runner|group:<group>|all>
  runnerctl logs <runner>
  runnerctl plan [runner|group:<group>|all]
  runnerctl migrate <runner|group:<group>|all>
  runnerctl on-demand <runner|group:<group>|all>
  runnerctl autostart <runner|group:<group>|all>
  runnerctl repo [owner/repo|.]
  runnerctl ensure [owner/repo|.]
  runnerctl add [owner/repo|.] [--profile PROFILE] [--group GROUP] [--labels CSV] [--name NAME]
                 [--runner-version VERSION|latest] [--runner-arch auto|x64|arm64]
  runnerctl remove <runner> [--plan] [--yes] [--keep-remote] [--delete-dir]
  runnerctl package detect
  runnerctl package ensure [--version VERSION|latest] [--arch auto|x64|arm64]
  runnerctl skills list
  runnerctl skills install [codex|copilot|claude|agents|all]
  runnerctl platform-home
  runnerctl platform-doctor

Notas:
  - on-demand é a policy padrão.
  - "ensure ." inicia somente os runners habilitados mapeados ao repositório atual.
  - "add" usa GitHub CLI autenticado, não persiste o registration token e o envia ao helper interno por stdin; o config.sh oficial recebe o token somente durante o registro.
EOF
}

resolve_platform_home() {
  local candidate=""

  if [[ -n "${ACTIONS_RUNNERS_HOME:-}" ]]; then
    candidate="$ACTIONS_RUNNERS_HOME"
  elif [[ -f "$PLATFORM_HOME_FILE" ]]; then
    candidate="$(head -n 1 "$PLATFORM_HOME_FILE" | tr -d '\r\n')"
  elif [[ -x "$SCRIPT_DIR/runners.sh" ]]; then
    candidate="$SCRIPT_DIR"
  elif [[ -x "$HOME/actions-runners/runners.sh" ]]; then
    candidate="$HOME/actions-runners"
  fi

  [[ -n "$candidate" ]] || die "platform home não encontrado; rode ./install.sh no checkout ou defina ACTIONS_RUNNERS_HOME"
  candidate="$(realpath -m "$candidate")"
  [[ -x "$candidate/runners.sh" ]] || die "platform home inválido: $candidate"
  [[ -x "$candidate/runner-services.sh" ]] || die "runner-services.sh ausente em: $candidate"

  printf '%s\n' "$candidate"
}

PLATFORM_HOME="$(resolve_platform_home)"
export ACTIONS_RUNNERS_HOME="$PLATFORM_HOME"
# shellcheck source=/dev/null
source "$PLATFORM_HOME/runner-runtime-env.sh"

normalize_repo() {
  local value="${1:-}"
  value="${value%.git}"
  value="${value#git@github.com:}"
  value="${value#ssh://git@github.com/}"
  value="${value#https://github.com/}"
  value="${value#http://github.com/}"
  printf '%s\n' "${value,,}"
}

current_repo() {
  local repo=""

  if command -v gh >/dev/null 2>&1; then
    repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null || true)"
  fi

  if [[ -z "$repo" ]] && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    repo="$(git remote get-url origin 2>/dev/null || true)"
  fi

  repo="$(normalize_repo "$repo")"
  [[ "$repo" == */* ]] || return 1
  printf '%s\n' "$repo"
}

resolve_repo() {
  local requested="${1:-.}"
  local repo

  if [[ -z "$requested" || "$requested" == "." ]]; then
    repo="$(current_repo || true)"
  else
    repo="$(normalize_repo "$requested")"
  fi

  [[ "$repo" == */* ]] || die "não foi possível resolver owner/repo"
  printf '%s\n' "$repo"
}

repo_slug() {
  local repo="$1"
  printf '%s\n' "${repo##*/}" | tr '[:upper:]' '[:lower:]'
}

runners_for_repo() {
  local repo="$1"
  [[ -f "$RUNNERS_CONFIG" ]] || die "registry não encontrado: $RUNNERS_CONFIG"

  awk -F'|' -v wanted="$repo" '
    /^[[:space:]]*#/ || NF < 5 { next }
    {
      name=$1
      mapped=$4
      enabled=$5
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", mapped)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", enabled)
      if (tolower(mapped) == tolower(wanted) && tolower(enabled) != "false") {
        print name
      }
    }
  ' "$RUNNERS_CONFIG"
}

ensure_repo() {
  local repo="$1"
  local runner
  local -a runners=()

  mapfile -t runners < <(runners_for_repo "$repo")
  [[ "${#runners[@]}" -gt 0 ]] || die "nenhum runner habilitado mapeado para $repo"

  echo "Repo: $repo"
  for runner in "${runners[@]}"; do
    "$PLATFORM_HOME/runners.sh" start "$runner"
  done

  for runner in "${runners[@]}"; do
    "$PLATFORM_HOME/runners.sh" status "$runner"
    "$PLATFORM_HOME/runners.sh" health "$runner"
  done
}

infer_profile_from_dir() {
  local dir="$1"

  if [[ -f "$dir/pubspec.yaml" ]]; then
    echo flutter
  elif [[ -f "$dir/package.json" ]]; then
    echo node
  elif [[ -f "$dir/pyproject.toml" || -f "$dir/requirements.txt" || -f "$dir/poetry.lock" ]]; then
    echo python
  elif [[ -f "$dir/pom.xml" || -f "$dir/build.gradle" || -f "$dir/build.gradle.kts" ]]; then
    echo java
  elif [[ -f "$dir/go.mod" ]]; then
    echo go
  elif find "$dir" -maxdepth 2 \( -name '*.sln' -o -name '*.csproj' \) -print -quit 2>/dev/null | grep -q .; then
    echo dotnet
  else
    echo generic
  fi
}

add_runner() {
  local repo_arg="."
  local profile="auto"
  local group="auto"
  local labels=""
  local name=""
  local runner_version="latest"
  local runner_arch="auto"
  local repo slug source_dir token output runner_name
  local -a args=()

  if [[ $# -gt 0 && "$1" != --* ]]; then
    repo_arg="$1"
    shift
  fi

  while (($#)); do
    case "$1" in
      --profile)
        profile="${2:-}"
        shift 2
        ;;
      --group)
        group="${2:-}"
        shift 2
        ;;
      --labels)
        labels="${2:-}"
        shift 2
        ;;
      --name)
        name="${2:-}"
        shift 2
        ;;
      --runner-version)
        runner_version="${2:-}"
        shift 2
        ;;
      --runner-arch)
        runner_arch="${2:-}"
        shift 2
        ;;
      *)
        die "opção desconhecida em add: $1"
        ;;
    esac
  done

  repo="$(resolve_repo "$repo_arg")"
  slug="$(repo_slug "$repo")"

  command -v gh >/dev/null 2>&1 || die "GitHub CLI (gh) é obrigatório para runnerctl add"
  gh auth status >/dev/null 2>&1 || die "GitHub CLI não está autenticado"
  gh repo view "$repo" --json nameWithOwner,viewerPermission >/dev/null

  source_dir="$(pwd)"
  if [[ "$profile" == "auto" ]]; then
    if [[ "$repo_arg" == "." || -z "$repo_arg" ]]; then
      profile="$(infer_profile_from_dir "$source_dir")"
    else
      local current=""
      current="$(current_repo || true)"
      if [[ "$current" == "$repo" ]]; then
        profile="$(infer_profile_from_dir "$source_dir")"
      else
        profile="generic"
      fi
    fi
  fi

  if [[ -z "$labels" ]]; then
    if [[ "$profile" == "generic" ]]; then
      labels="$slug,local-runner"
    else
      labels="$profile,$slug,local-runner"
    fi
  fi

  args=(
    --repo-url "https://github.com/$repo"
    --token-stdin
    --profile "$profile"
    --group "$group"
    --labels "$labels"
    --runner-version "$runner_version"
    --runner-arch "$runner_arch"
  )
  [[ -n "$name" ]] && args+=(--name "$name")

  echo "Registrando runner para $repo"
  echo "Profile: $profile"
  echo "Group: $group"
  echo "Labels: $labels"
  echo "Runner version: $runner_version"
  echo "Runner arch: $runner_arch"

  token="$(gh api --method POST "repos/$repo/actions/runners/registration-token" --jq .token)"
  [[ -n "$token" ]] || die "GitHub não retornou registration token"

  if ! output="$(printf '%s\n' "$token" | "$PLATFORM_HOME/configure-runner.sh" "${args[@]}" 2>&1)"; then
    unset token
    printf '%s\n' "$output" >&2
    return 1
  fi
  unset token

  printf '%s\n' "$output"
  runner_name="$(printf '%s\n' "$output" | awk -F': ' '/^Nome local: /{print $2}' | tail -n 1)"
  [[ -n "$runner_name" ]] || die "runner foi configurado, mas o nome local não pôde ser resolvido"

  "$PLATFORM_HOME/runner-services.sh" migrate "$runner_name"
  "$PLATFORM_HOME/runners.sh" doctor "$runner_name"
  "$PLATFORM_HOME/runners.sh" health "$runner_name"

  echo "[OK] runner=$runner_name repo=$repo policy=$RUNNER_BOOT_POLICY"
}

trim_value() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

runner_record() {
  local runner="$1"
  [[ -f "$RUNNERS_CONFIG" ]] || die "registry não encontrado: $RUNNERS_CONFIG"

  awk -F'|' -v wanted="$runner" '
    /^[[:space:]]*#/ || NF < 5 { next }
    {
      name=$1
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
      if (name == wanted) print
    }
  ' "$RUNNERS_CONFIG"
}

runner_metadata_value() {
  local file="$1" key="$2"
  [[ -f "$file" ]] || return 1

  case "$key" in
    agentId)
      grep -oE '"agentId"[[:space:]]*:[[:space:]]*[0-9]+' "$file" 2>/dev/null |
        head -n 1 |
        grep -oE '[0-9]+$'
      ;;
    agentName)
      grep -oE '"agentName"[[:space:]]*:[[:space:]]*"[^"]*"' "$file" 2>/dev/null |
        head -n 1 |
        sed -E 's/^.*"agentName"[[:space:]]*:[[:space:]]*"([^"]*)".*$/\1/'
      ;;
    *)
      return 1
      ;;
  esac
}

runner_local_unit() {
  local path="$1"
  local unit working_dir

  if [[ -f "$path/.service" ]]; then
    unit="$(tr -d '[:space:]' < "$path/.service")"
    [[ -n "$unit" ]] && {
      printf '%s\n' "$unit"
      return 0
    }
  fi

  if command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
    while read -r unit; do
      [[ -n "$unit" ]] || continue
      working_dir="$(systemctl show "$unit" --property=WorkingDirectory --value 2>/dev/null || true)"
      if [[ "$working_dir" == "$path" ]]; then
        printf '%s\n' "$unit"
        return 0
      fi
    done < <(
      systemctl list-unit-files 'actions.runner.*.service' --no-legend --no-pager 2>/dev/null |
        awk '{print $1}'
    )
  fi

  printf '%s\n' "unknown"
}

remove_registry_entry() {
  local runner="$1"
  local tmp

  tmp="$(mktemp)"
  awk -F'|' -v wanted="$runner" '
    /^[[:space:]]*#/ { print; next }
    {
      name=$1
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
      if (name != wanted) print
    }
  ' "$RUNNERS_CONFIG" > "$tmp"
  chmod --reference="$RUNNERS_CONFIG" "$tmp" 2>/dev/null || chmod 600 "$tmp"
  mv "$tmp" "$RUNNERS_CONFIG"
}

validate_runner_delete_path() {
  local path="$1"
  local safe_path data_root_real platform_home_real home_real

  safe_path="$(realpath -m "$path")"
  data_root_real="$(realpath -m "$RUNNER_DATA_ROOT")"
  platform_home_real="$(realpath -m "$PLATFORM_HOME")"
  home_real="$(realpath -m "$HOME")"

  [[ "$safe_path" != "/" ]] || die "recusando apagar /"
  [[ "$safe_path" != "$home_real" ]] || die "recusando apagar HOME"
  [[ "$safe_path" != "$platform_home_real" ]] || die "recusando apagar platform home"
  [[ "$safe_path" != "$data_root_real" ]] || die "recusando apagar RUNNER_DATA_ROOT"
  [[ -f "$safe_path/.runner" || -x "$safe_path/config.sh" ]] ||
    die "recusando apagar diretório sem marcador de GitHub Runner: $safe_path"

  printf '%s\n' "$safe_path"
}

remove_runner() {
  local runner=""
  local plan_only=0
  local yes=0
  local keep_remote=0
  local delete_dir=0
  local record count path profile repo enabled group rest unit
  local runner_file remote_id remote_name remote_row="" remote_status=""
  local safe_delete_path=""

  [[ $# -ge 1 ]] || die "remove exige o nome exato de um runner"
  runner="$1"
  shift

  [[ "$runner" != "all" && "$runner" != group:* ]] ||
    die "remove aceita somente um runner exato; all/group não são permitidos"

  while (($#)); do
    case "$1" in
      --plan)
        plan_only=1
        shift
        ;;
      --yes)
        yes=1
        shift
        ;;
      --keep-remote)
        keep_remote=1
        shift
        ;;
      --delete-dir)
        delete_dir=1
        shift
        ;;
      *)
        die "opção desconhecida em remove: $1"
        ;;
    esac
  done

  [[ "$delete_dir" -eq 0 || "$keep_remote" -eq 0 ]] ||
    die "--delete-dir não pode ser combinado com --keep-remote"

  record="$(runner_record "$runner")"
  count="$(printf '%s\n' "$record" | awk 'NF { count++ } END { print count+0 }')"
  [[ "$count" -eq 1 ]] ||
    die "esperava exatamente 1 entrada para '$runner' no registry; encontrei $count"

  IFS='|' read -r _name path profile repo enabled group rest <<< "$record"
  path="$(trim_value "$path")"
  repo="$(normalize_repo "$(trim_value "$repo")")"
  profile="$(trim_value "$profile")"
  group="$(trim_value "$group")"
  enabled="$(trim_value "$enabled")"

  [[ -n "$path" ]] || die "$runner: path ausente no registry"
  path="$(realpath -m "$path")"
  runner_file="$path/.runner"
  unit="$(runner_local_unit "$path")"

  remote_id="$(runner_metadata_value "$runner_file" agentId || true)"
  remote_name="$(runner_metadata_value "$runner_file" agentName || true)"

  if [[ "$delete_dir" -eq 1 ]]; then
    safe_delete_path="$(validate_runner_delete_path "$path")"
  fi

  echo "Removal plan:"
  echo "- runner: $runner"
  echo "- repo: ${repo:-unknown}"
  echo "- path: $path"
  echo "- profile: ${profile:-generic}"
  echo "- group: ${group:-unknown}"
  echo "- systemd unit: $unit"
  echo "- local service: STOP + UNINSTALL"
  if [[ "$keep_remote" -eq 1 ]]; then
    echo "- GitHub registration: KEEP"
  else
    echo "- GitHub registration: REMOVE"
    echo "- remote runner: ${remote_name:-unknown}"
    echo "- remote id: ${remote_id:-unknown}"
  fi
  echo "- registry entry: REMOVE"
  if [[ "$delete_dir" -eq 1 ]]; then
    echo "- local directory: DELETE ($safe_delete_path)"
  else
    echo "- local directory: KEEP"
  fi

  if [[ "$plan_only" -eq 1 ]]; then
    return 0
  fi

  if [[ "$yes" -ne 1 ]]; then
    echo
    echo "Nenhuma alteração aplicada."
    echo "Revise o plano e rode novamente com --yes."
    return 0
  fi

  if [[ "$keep_remote" -eq 0 ]]; then
    [[ "$repo" == */* ]] ||
      die "$runner: repo inválido para remoção remota; use --keep-remote para detach local"
    [[ "$remote_id" =~ ^[0-9]+$ ]] ||
      die "$runner: agentId não encontrado em $runner_file; use --keep-remote para detach local"
    [[ -n "$remote_name" ]] ||
      die "$runner: agentName não encontrado em $runner_file; use --keep-remote para detach local"

    command -v gh >/dev/null 2>&1 || die "gh é obrigatório para remoção remota"
    gh auth status >/dev/null 2>&1 || die "GitHub CLI não está autenticado"

    remote_row="$(
      gh api "repos/$repo/actions/runners" --paginate \
        --jq ".runners[] | select(.id == $remote_id) | [.id, .name, .status] | @tsv"
    )"

    if [[ -n "$remote_row" ]]; then
      IFS=$'\t' read -r _remote_id checked_name remote_status <<< "$remote_row"
      [[ "$checked_name" == "$remote_name" ]] ||
        die "proteção acionada: remote id $remote_id pertence a '$checked_name', esperado '$remote_name'"
      echo "[CHECK] GitHub runner=$checked_name id=$remote_id status=$remote_status"
    else
      echo "[INFO] registration remota já não existe: repo=$repo id=$remote_id"
    fi
  fi

  "$PLATFORM_HOME/runners.sh" stop "$runner"
  "$PLATFORM_HOME/runner-services.sh" uninstall "$runner"

  if [[ "$keep_remote" -eq 0 && -n "$remote_row" ]]; then
    gh api --method DELETE "repos/$repo/actions/runners/$remote_id"
    echo "[OK] registration remota removida: $repo/$remote_name ($remote_id)"
  fi

  remove_registry_entry "$runner"
  echo "[OK] registry removido: $runner"

  if [[ "$delete_dir" -eq 1 ]]; then
    rm -rf -- "$safe_delete_path"
    echo "[OK] diretório local removido: $safe_delete_path"
  else
    echo "[KEEP] diretório local preservado: $path"
  fi

  echo "[OK] runner removido da plataforma local: $runner"
}

platform_doctor() {
  local rc=0
  echo "platform_home=$PLATFORM_HOME"
  echo "runners_config=$RUNNERS_CONFIG"
  echo "runner_data_root=$RUNNER_DATA_ROOT"
  echo "runner_cache_root=$RUNNER_CACHE_ROOT"
  echo "runner_state_root=$RUNNER_STATE_ROOT"
  echo "boot_policy=$RUNNER_BOOT_POLICY"

  for cmd in bash git tar sha256sum systemctl; do
    if command -v "$cmd" >/dev/null 2>&1; then
      echo "[OK] command=$cmd"
    else
      echo "[MISSING] command=$cmd"
      rc=1
    fi
  done

  if [[ -x "$PLATFORM_HOME/runner-package.sh" ]]; then
    package_platform="$("$PLATFORM_HOME/runner-package.sh" detect 2>/dev/null || true)"
    if [[ -n "$package_platform" ]]; then
      echo "[OK] runner_package_platform=$package_platform"
    else
      echo "[MISSING] runner_package_platform=unsupported"
      rc=1
    fi
  else
    echo "[MISSING] runner-package.sh"
    rc=1
  fi

  if command -v gh >/dev/null 2>&1; then
    if gh auth status >/dev/null 2>&1; then
      echo "[OK] gh=authenticated"
    else
      echo "[WARN] gh=installed-not-authenticated"
    fi
  else
    echo "[WARN] gh=missing add=unavailable"
  fi

  if [[ -d /run/systemd/system ]]; then
    echo "[OK] systemd=active"
  else
    echo "[MISSING] systemd=inactive"
    rc=1
  fi

  [[ -f "$RUNNERS_CONFIG" ]] && echo "[OK] registry=present" || echo "[WARN] registry=missing run='runnerctl init'"
  return "$rc"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  help|-h|--help)
    usage
    ;;
  platform-home)
    printf '%s\n' "$PLATFORM_HOME"
    ;;
  platform-doctor)
    platform_doctor
    ;;
  init)
    exec "$PLATFORM_HOME/init-machine-config.sh" "$@"
    ;;
  list|groups)
    exec "$PLATFORM_HOME/runners.sh" "$cmd" "$@"
    ;;
  status|health|doctor)
    target="${1:-all}"
    exec "$PLATFORM_HOME/runners.sh" "$cmd" "$target"
    ;;
  start|stop|restart|logs)
    [[ $# -ge 1 ]] || die "$cmd exige runner, group:<group> ou all"
    exec "$PLATFORM_HOME/runners.sh" "$cmd" "$@"
    ;;
  plan|migrate|on-demand|autostart)
    target="${1:-all}"
    exec "$PLATFORM_HOME/runner-services.sh" "$cmd" "$target"
    ;;
  repo)
    resolve_repo "${1:-.}"
    ;;
  ensure)
    repo="$(resolve_repo "${1:-.}")"
    ensure_repo "$repo"
    ;;
  package)
    sub="${1:-detect}"
    shift || true
    case "$sub" in
      detect|ensure)
        exec "$PLATFORM_HOME/runner-package.sh" "$sub" "$@"
        ;;
      *)
        die "package aceita detect ou ensure"
        ;;
    esac
    ;;
  add)
    add_runner "$@"
    ;;
  remove)
    remove_runner "$@"
    ;;
  skills)
    sub="${1:-list}"
    shift || true
    case "$sub" in
      list)
        exec "$PLATFORM_HOME/install-agent-skills.sh" --list
        ;;
      install)
        tool="${1:-all}"
        exec "$PLATFORM_HOME/install-agent-skills.sh" --tool "$tool"
        ;;
      *)
        die "skills aceita list ou install"
        ;;
    esac
    ;;
  *)
    die "comando desconhecido: $cmd"
    ;;
esac
